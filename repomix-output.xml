import pool from "../../config/connectionToSql.js";

export const createViatico = async (data) => {
  const [result] = await pool.query("INSERT INTO viaticos SET ?", [data]);
  return { id: result.insertId };
};

export const insertDetalles = async (viaticoId, detalles) => {
  const values = detalles.map((d) => [
    viaticoId,
    d.tipo,
    d.descripcion,
    d.cantidad,
    d.precio_unitario,
    d.fecha,
  ]);

  await pool.query(
    `INSERT INTO viaticos_detalle 
    (viatico_id, tipo, descripcion, cantidad, precio_unitario, fecha)
    VALUES ?`,
    [values],
  );
};

export const calculateTotal = async (viaticoId) => {
  const [rows] = await pool.query(
    "SELECT SUM(total) as total FROM viaticos_detalle WHERE viatico_id = ?",
    [viaticoId],
  );
  return rows[0].total || 0;
};

export const updateTotal = async (id, total) => {
  await pool.query("UPDATE viaticos SET total_general = ? WHERE id = ?", [
    total,
    id,
  ]);
};

export const getAll = async () => {
  const [rows] = await pool.query("SELECT * FROM viaticos");
  return rows;
};

export const getById = async (id) => {
  const [rows] = await pool.query("SELECT * FROM viaticos WHERE id = ?", [id]);
  return rows[0];
};

export const updateViatico = async (id, data) => {
  await pool.query("UPDATE viaticos SET ? WHERE id = ?", [data, id]);
};

export const deleteDetalles = async (viaticoId) => {
  await pool.query("DELETE FROM viaticos_detalle WHERE viatico_id = ?", [
    viaticoId,
  ]);
};

export const deleteViatico = async (id) => {
  await pool.query("DELETE FROM viaticos WHERE id = ?", [id]);
};

export const checkConflictoFechas = async (
  empleadoId,
  inicio,
  fin,
  conn,
  excludeId = null,
) => {
  let query = `
    SELECT id FROM viaticos
    WHERE empleado_id = ?
    AND (fecha_salida <= ? AND fecha_regreso >= ?)
  `;

  const params = [empleadoId, fin, inicio];

  if (excludeId) {
    query += " AND id != ?";
    params.push(excludeId);
  }

  const [rows] = await conn.query(query, params);
  return rows.length > 0;
};

export const checkVehiculoDisponible = async (
  vehiculoId,
  inicio,
  fin,
  conn,
) => {
  const [rows] = await conn.query(
    `
    SELECT id FROM reservas_vehiculos
    WHERE vehiculo_id = ?
    AND estado IN ('Reservado','En Uso')
    AND (fecha_inicio <= ? AND fecha_fin >= ?)
  `,
    [vehiculoId, fin, inicio],
  );

  return rows.length > 0;
};

export const getNombreDestino = async (siteId, conn) => {
  const [rows] = await conn.query(
    "SELECT nombre FROM clientes_sites WHERE id = ?",
    [siteId],
  );

  return rows[0];
};

export const getByReservaId = async (reservaId, conn) => {
  const [rows] = await conn.query(
    "SELECT id FROM viaticos WHERE reserva_id = ?",
    [reservaId],
  );
  return rows[0];
};

//
export const checkConflictoEmpleado = async (empleadoId, inicio, fin, conn) => {
  const [rows] = await conn.query(
    `
    SELECT id FROM viaticos 
    WHERE empleado_id = ? 
    AND estado NOT IN ('Rechazado', 'Finalizado')
    AND (fecha_salida <= ? AND fecha_regreso >= ?)`,
    [empleadoId, fin, inicio],
  );
  return rows.length > 0;
};
