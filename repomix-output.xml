const generarDetallesAutomaticos = (fechaInicio, fechaFin, zona) => {
  const detalles = [];

  const multiplicador = obtenerMultiplicador(zona);

  const inicio = new Date(fechaInicio);
  const fin = new Date(fechaFin);

  let current = new Date(inicio);

  while (current <= fin) {
    const fecha = new Date(current);

    detalles.push({
      tipo: "DESAYUNO",
      cantidad: 1,
      precio_unitario: preciosBase.DESAYUNO * multiplicador,
      fecha,
    });

    detalles.push({
      tipo: "ALMUERZO",
      cantidad: 1,
      precio_unitario: preciosBase.ALMUERZO * multiplicador,
      fecha,
    });

    detalles.push({
      tipo: "CENA",
      cantidad: 1,
      precio_unitario: preciosBase.CENA * multiplicador,
      fecha,
    });

    current.setDate(current.getDate() + 1);
  }

  // 🔥 calcular noches
  const noches = Math.max(0, Math.ceil((fin - inicio) / (1000 * 60 * 60 * 24)));

  if (noches > 0) {
    detalles.push({
      tipo: "HOSPEDAJE",
      cantidad: noches,
      precio_unitario: preciosBase.HOSPEDAJE * multiplicador,
      fecha: inicio,
    });
  }

  return detalles;
};

