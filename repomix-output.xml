import Joi from "joi";

export const createSchema = Joi.object({
  empleado_id: Joi.number().required(),
  vehiculo_id: Joi.number().required(),
  // cliente_id: Joi.number().required(),

  fecha_salida: Joi.date().required(),
  fecha_regreso: Joi.date().required(),

  origen_site_id: Joi.number().optional().allow(null),
  destino_site_id: Joi.number().optional().allow(null),

  motivo_viaje: Joi.string().allow(null, ""),

  detalles: Joi.array()
    .items(
      Joi.object({
        tipo: Joi.string()
          .valid(
            "DESAYUNO",
            "ALMUERZO",
            "CENA",
            "HOSPEDAJE",
            "COMBUSTIBLE",
            "PEAJE",
            "IMPREVISTO",
          )
          .required(),

        descripcion: Joi.string().allow("", null),

        cantidad: Joi.number().min(1).required(),
        precio_unitario: Joi.number().min(0).required(),

        fecha: Joi.date().required(),
      }),
    )
    .min(1)
    .required(),
});
