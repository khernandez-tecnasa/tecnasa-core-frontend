import * as repo from "./viaticos.repository.js";
import pool from "../../config/connectionToSql.js";

const preciosBase = {
  DESAYUNO: 120,
  ALMUERZO: 200,
  CENA: 180,
  HOSPEDAJE: 1500,
};

const obtenerMultiplicador = (zona) => {
  if (!zona) return 1;

  const z = zona.toUpperCase();

  if (z.includes("ROATAN")) return 1.5;
  if (z.includes("CEIBA")) return 1.3;

  return 1;
};

export const create = async (data) => {
  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    // 1. VALIDACIÓN DE FECHAS
    if (new Date(data.fecha_salida) > new Date(data.fecha_regreso)) {
      throw new Error(
        "La fecha de salida no puede ser mayor que la de regreso",
      );
    }

    // 2. VALIDAR CONFLICTO DE VIÁTICOS (EMPLEADO)
    const conflictoEmpleado = await repo.checkConflictoFechas(
      data.empleado_id,
      data.fecha_salida,
      data.fecha_regreso,
      conn,
    );

    if (conflictoEmpleado) {
      throw new Error("El empleado ya tiene un viático en ese rango de fechas");
    }

    // 3. VALIDAR VEHÍCULO DISPONIBLE
    const conflictoVehiculo = await repo.checkVehiculoDisponible(
      data.vehiculo_id,
      data.fecha_salida,
      data.fecha_regreso,
      conn,
    );

    if (conflictoVehiculo) {
      throw new Error("El vehículo ya está ocupado en ese rango de fechas");
    }

    // 4. CREAR VIÁTICO
    const viatico = await repo.createViatico(data, conn);

    // 5. INSERTAR DETALLES
    let detalles = data.detalles;

    if (!detalles || detalles.length === 0) {
      let zona = "";

      if (data.destino_site_id) {
        const destino = await repo.getNombreDestino(data.destino_site_id, conn);

        zona = destino?.nombre || "";
      }

      detalles = generarDetallesAutomaticos(
        data.fecha_salida,
        data.fecha_regreso,
        zona,
      );
    }

    // 🔥 guardar detalles
    await repo.insertDetalles(viatico.id, detalles, conn);

    // 6. CALCULAR TOTAL
    const total = await repo.calculateTotal(viatico.id, conn);

    await repo.updateTotal(viatico.id, total, conn);

    await conn.commit();

    return { id: viatico.id };
  } catch (error) {
    await conn.rollback();
    throw error;
  } finally {
    conn.release();
  }
};

export const getAll = repo.getAll;
export const getById = repo.getById;

export const update = async (id, data) => {
  const conn = await pool.getConnection();

  try {
    await conn.beginTransaction();

    // validar fechas
    if (new Date(data.fecha_salida) > new Date(data.fecha_regreso)) {
      throw new Error("Fechas inválidas");
    }

    // conflicto empleado (excluyendo el actual)
    const conflicto = await repo.checkConflictoFechas(
      data.empleado_id,
      data.fecha_salida,
      data.fecha_regreso,
      conn,
      id,
    );

    if (conflicto) {
      throw new Error("Conflicto de fechas con otro viático");
    }

    await repo.updateViatico(id, data, conn);

    if (data.detalles) {
      await repo.deleteDetalles(id, conn);
      await repo.insertDetalles(id, data.detalles, conn);
    }

    const total = await repo.calculateTotal(id, conn);
    await repo.updateTotal(id, total, conn);

    await conn.commit();

    return { success: true };
  } catch (error) {
    await conn.rollback();
    throw error;
  } finally {
    conn.release();
  }
};

export const generarViaticoDesdeReserva = async (reserva, conn) => {
  const data = {
    empleado_id: reserva.empleado_id,
    vehiculo_id: reserva.vehiculo_id,
    cliente_id: null,
    reserva_id: reserva.id,

    fecha_salida: reserva.fecha_inicio,
    fecha_regreso: reserva.fecha_fin,

    estado: "Borrador",
  };

  const viatico = await repo.createViatico(data, conn);

  return viatico;
};

