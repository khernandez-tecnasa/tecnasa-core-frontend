import { Router } from "express";
import {
  createViatico,
  getAll,
  getById,
  update,
  remove,
} from "./viaticos.controller.js";

import {
  authenticate,
  authorizeByPermisos,
} from "../../middleware/auth.middleware.js";

import { validateRequest } from "../../middleware/validateRequest.js";
import { createSchema } from "./viaticos.schema.js";

const router = Router();

router.post(
  "/",
  authenticate,
  authorizeByPermisos(["create_viatico"]),
  validateRequest(createSchema),
  createViatico,
);

router.get("/", authenticate, authorizeByPermisos(["read_viatico"]), getAll);

router.get(
  "/:id",
  authenticate,
  authorizeByPermisos(["read_viatico"]),
  getById,
);

router.put(
  "/:id",
  authenticate,
  authorizeByPermisos(["update_viatico"]),
  validateRequest(createSchema),
  update,
);

router.delete(
  "/:id",
  authenticate,
  authorizeByPermisos(["delete_viatico"]),
  remove,
);

export default router;
